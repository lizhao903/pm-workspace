# 整个 data/ 都不入库，不要改回按扩展名逐条列。
#
# 原来写的是 /data/*.db 这种逐条模式，只盖得住顶层：POST /api/admin/snapshot
# 会往 data/backups/ 里落快照，那是**用户全量数据的副本，含明文 api_key**，
# 而它不匹配任何一条规则——一次 `git add -A` 就会把它连同密钥写进 git 历史，
# 而 git 历史是很难干净清掉的。列举要排除的东西，总会漏掉明天才出现的那个。
/data/
/bin/
/web/node_modules/
# 前端构建产物不入库，但 //go:embed all:dist 要求目录至少有一个文件，
# 所以留一个 .gitkeep（all: 前缀会把点开头的文件也嵌进去），否则新克隆 go build 编译失败。
#
# 不留 index.html：vite 每次构建都会重写它，里面引用的是带 hash 的 assets 文件名，
# 而那些文件本身不入库。提交它等于在仓库里放一个指向不存在资源的页面——
# 新克隆 go build 会成功，跑起来却是白屏，而「构建通过」看上去一切正常。
# 现在没有 index.html 时 webui 会回一句「前端尚未构建，执行 make ui」，是句实话。
# vite build 会清空 outDir，把 .gitkeep 一起删掉——所以 web/package.json 的
# build 脚本在 vite 之后把它补回来。少了那一步，「新克隆能 build」这条会在
# 下一次构建之后悄悄失效，而且只有新克隆的人才撞得到。
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep
.DS_Store
/logs/
# TLS 证书与私钥（scripts/setup-tls.sh 生成）。私钥绝不入库，
# 且 mkcert 签的证书只对本机那个 CA 有效，别的机器拿去也用不了。
/certs/

# 根目录下的构建产物（Makefile 的临时产物，正式产物在 /bin）
/pmw-mcp
/pmw
