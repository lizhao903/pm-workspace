flowchart TB
  %% ---------- 1 触发 ----------
  subgraph S1["1 触发与激活"]
    direction TB
    T1["IM 消息<br/>Slack / Telegram"]
    T2["平台新建任务"]
    T3{"是不是需求？<br/>意图识别"}
    T4["建需求任务<br/>记录提出人、来源消息、附件"]
    T5["回执需求方<br/>已创建任务 + 开始需求规划"]
    T0["普通消息<br/>不建任务"]
    T1 --> T3
    T3 -->|"是"| T4
    T3 -->|"否"| T0
    T2 --> T4
    T4 --> T5
  end

  %% ---------- 2 看板 ----------
  BOARD[["2 需求看板<br/>按提出人筛选，状态随流程实时变化<br/>（状态见第 3 节）"]]

  %% ---------- 3 分类 ----------
  subgraph S3["3 分类 Agent"]
    direction TB
    C1["读项目清单、目录、历史需求<br/>判断目标平台 / 项目"]
    C2{"置信度够高？"}
    C3["向提出人确认<br/>列出候选项目"]
    C4["绑定项目与工作目录<br/>选定产品角色提示词"]
    C1 --> C2
    C2 -->|"是"| C4
    C2 -->|"否"| C3
    C3 -->|"提出人选定"| C4
  end

  %% ---------- 4 产品 ----------
  subgraph S4["4 产品 Agent（在目标项目目录）"]
    direction TB
    P1["读现有 PRD、原型、规格"]
    P2{"需求有歧义？"}
    P3["向提出人提问<br/>等回复"]
    P4["写 PRD<br/>目标 / 范围 / 验收标准"]
    P5["更新原型与规格"]
    P6["自检<br/>验收标准可测、原型可走通"]
    P1 --> P2
    P2 -->|"有"| P3 --> P4
    P2 -->|"没有"| P4
    P4 --> P5 --> P6
  end

  %% ---------- 5 评审 ----------
  subgraph S5["5 研发评审 Agent"]
    direction TB
    R1["按清单评审<br/>完整性 / 可行性 / 影响面 / 验收标准"]
    R2{"评审通过？"}
    R3{"已退回 3 轮？"}
    R4["评审意见<br/>逐条写明要改什么"]
    R5["人工裁决"]
    R1 --> R2
    R2 -->|"不通过"| R3
    R3 -->|"否"| R4
    R3 -->|"是"| R5
  end

  %% ---------- 6 研发 ----------
  subgraph S6["6 研发 pipeline"]
    direction TB
    D0["拆研发任务<br/>建分支"]
    D1["功能开发"]
    D2["测试用例设计<br/>对照验收标准"]
    D3["自动化测试设计<br/>单测 / 接口 / 端到端脚本"]
    D4["合流：构建 + lint + 单测"]
    D5["代码自审"]
    D6{"全部通过？"}
    D0 --> D1 & D2 & D3
    D1 & D2 & D3 --> D4
    D4 --> D5 --> D6
    D6 -->|"否，重试未超限"| D1
  end

  %% ---------- 7 部署测试 ----------
  subgraph S7["7 自动部署测试"]
    direction TB
    E1["部署到测试环境<br/>临时实例，不带生产凭证"]
    E2["冒烟测试"]
    E3["自动化回归 + 端到端<br/>截图留证"]
    E4{"测试通过？"}
    E5["生成缺陷单<br/>附日志与截图"]
    E1 --> E2 --> E3 --> E4
    E4 -->|"否"| E5
  end

  %% ---------- 8 通知 ----------
  subgraph S8["8 通知验收"]
    direction TB
    N1["通知提出人与测试人员<br/>IM + 平台通知"]
    N2["附：测试环境地址、变更说明<br/>验收清单、测试报告、截图"]
    N1 --- N2
  end

  %% ---------- 9 人工确认与发布 ----------
  subgraph S9["9 人工确认与发布 pipeline"]
    direction TB
    H1{"人工测试结果"}
    H2{"问题归属"}
    F0["反馈 Agent<br/>整理确认结论"]
    F1["版本号 + 更新日志"]
    F2["打包构建"]
    F3{"上线审批<br/>人工点确认"}
    F4["备份数据库、核对密钥<br/>发布到生产"]
    F5["线上冒烟"]
    F6{"正常？"}
    F7["自动回滚<br/>通知负责人"]
    F8["回复原 IM 消息：已上线<br/>看板关闭"]
    H1 -->|"不通过"| H2
    H1 -->|"通过"| F0 --> F1 --> F2 --> F3
    F3 -->|"批准"| F4 --> F5 --> F6
    F3 -->|"暂缓"| F2
    F6 -->|"是"| F8
    F6 -->|"否"| F7
  end

  %% ---------- 10 旁路：原型回写 ----------
  subgraph S10["10 旁路 · 原型回写（不阻塞主线）"]
    direction TB
    B0["触发<br/>发布成功 / 生产分支有合并 / 每日巡检"]
    B1["原型同步 Agent<br/>对比上线代码与原型、规格、PRD"]
    B2["更新原型库与规格状态<br/>登记差异，通知产品"]
    B0 --> B1 --> B2
  end

  %% ---------- 主线 ----------
  T5 --> C1
  T4 -.->|"出现在看板"| BOARD
  C4 --> P1
  P6 --> R1
  R2 -->|"通过"| D0
  D6 -->|"是"| E1
  E4 -->|"是"| N1
  N2 --> H1

  %% ---------- 回退 ----------
  R4 -->|"退回修改"| P4
  R5 -->|"放行"| D0
  R5 -->|"打回"| P4
  D6 -->|"超限"| R5
  E5 -->|"修复"| D1
  H2 -->|"实现缺陷"| D1
  H2 -->|"需求偏差"| P4
  F7 --> D1

  %% ---------- 看板同步 ----------
  C4 -.-> BOARD
  P6 -.-> BOARD
  D0 -.-> BOARD
  N1 -.-> BOARD
  F8 -.-> BOARD

  %% ---------- 旁路 ----------
  F8 -.->|"上线后触发"| B0
  B2 -.->|"原型与代码一致<br/>下次设计以此为准"| P1